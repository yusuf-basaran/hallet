{
  "name": "hallet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node tests/check.mjs",
    "test:rules": "firebase emulators:exec --project demo-hallet --only firestore \"node --test --test-concurrency=1 tests/firestore.test.mjs\"",
    "test:browser": "firebase emulators:exec --project demo-hallet --only auth,firestore \"node tests/browser.mjs\"",
    "test": "npm run check && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.17.0",
    "playwright": "1.56.1"
  }
}
